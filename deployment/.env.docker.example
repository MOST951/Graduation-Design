# ====================================================================
# 微博情感分析系统 - Docker 环境变量模板
# ====================================================================
# 使用说明:
# 1. 复制此文件为 .env.docker: cp .env.docker.example .env.docker
# 2. 修改下方的敏感配置值
# 3. 运行: docker-compose --env-file .env.docker up -d
# ====================================================================

# ====== 服务端口 ======
WEB_PORT=5000
DB_PORT=3306
REDIS_PORT=6379
FRONTEND_PORT=5173

# ====== Flask 配置 ======
FLASK_ENV=production
LOG_LEVEL=INFO

# ====== 安全密钥 (必须修改!) ======
SECRET_KEY=your-secret-key-at-least-32-characters-change-this

# ====== 数据库配置 (必须修改!) ======
DB_NAME=weibo_sentiment
DB_USER=weibo_user
DB_PASSWORD=YourStrongPassword123!
DB_ROOT_PASSWORD=YourRootPassword456!

# ====== Redis 配置 ======
REDIS_PASSWORD=

# ====== 安全提醒 ======
# 1. 生产环境必须修改所有默认密码
# 2. SECRET_KEY 必须使用强随机字符串
# 3. 切勿将此文件（修改后）提交到版本控制
