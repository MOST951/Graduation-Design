# ====================================================================
# 微博情感分析系统 - Docker 环境变量模板
# ====================================================================
# 适配: Ubuntu 24.04 + Docker Compose v2 + 1Panel
# VM 推荐配置: 4GB+ 内存 / 2+ 核 CPU / 20GB+ 磁盘
# 使用说明:
#   1. cp .env.docker.example .env.docker
#   2. 修改下方密码配置 (开发测试环境可直接启动)
#   3. ./deploy.sh        # 一键部署
#   4. ./deploy.sh stop   # 停止
# ====================================================================

# ====== 基础服务端口 ======
WEB_PORT=5000
DB_PORT=3306
REDIS_PORT=6379
FRONTEND_PORT=3001
JAVA_BACKEND_PORT=8081
SPARK_MASTER_PORT=7077
SPARK_WEBUI_PORT=8080

# ====== 大数据服务端口 (with-bigdata) ======
ZK_PORT=2181
HDFS_NAMENODE_PORT=9000
HDFS_NAMENODE_HTTP_PORT=50070
HDFS_DATANODE_HTTP_PORT=50075
HBASE_MASTER_PORT=16000
HBASE_MASTER_WEBUI_PORT=16010
HBASE_RS_PORT=16020
HBASE_RS_WEBUI_PORT=16030
HBASE_THRIFT_PORT=9090

# ====== 启用的 Profiles (逗号分隔) ======
# 可选: with-frontend, with-java-backend, with-spark, with-bigdata
# 轻量部署 (不含 Spark/HDFS/HBase):
#   ENABLED_PROFILES=with-frontend,with-java-backend
ENABLED_PROFILES=with-frontend,with-java-backend,with-spark,with-bigdata

# ====== Flask 配置 ======
FLASK_ENV=production
LOG_LEVEL=INFO

# ====== 安全密钥 (生产环境必须修改!) ======
SECRET_KEY=dev-secret-key-change-in-production-use-secrets-token-hex
JWT_SECRET=dev-jwt-secret-change-in-production-use-secrets-token-hex

# ====== 数据库配置 (生产环境必须修改!) ======
DB_NAME=weibo_sentiment
DB_USER=weibo_user
DB_PASSWORD=123456
DB_ROOT_PASSWORD=123456

# ====== Redis 配置 (留空则不设密码) ======
REDIS_PASSWORD=

# ====== 邮箱验证码 SMTP 配置 ======
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=微博舆情分析系统

# ====== Spark 资源配置 ======
SPARK_WORKER_MEMORY=4g
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY_LIMIT=4608M

# ====== 安全提醒 ======
# 1. 开发测试环境可直接使用默认密码 123456
# 2. 生产环境必须修改所有密码和密钥
#    生成方法: python3 -c "import secrets; print(secrets.token_hex(32))"
# 3. 切勿将修改后的 .env.docker 提交到版本控制

