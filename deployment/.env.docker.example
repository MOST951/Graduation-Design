# ====================================================================

# 微博情感分析系统 - Docker 环境变量模板

# ====================================================================

# 适配: Ubuntu 20.04 + Docker Compose v2 + 1Panel

# VM 推荐配置: 10GB 内存 / 4 核 CPU / 40GB 磁盘

# 使用说明:

#   1. cp .env.docker.example .env.docker

#   2. 修改下方带 "必须修改" 的配置值

#   3. 全部服务 (含大数据):

#      docker compose --env-file .env.docker \

#        --profile with-frontend --profile with-java-backend \

#        --profile with-spark --profile with-bigdata up -d

#   4. 轻量部署 (不含 HDFS/HBase):

#      docker compose --env-file .env.docker \

#        --profile with-frontend --profile with-java-backend \

#        --profile with-spark up -d

# ====================================================================



# ====== 基础服务端口 ======

WEB_PORT=5000

DB_PORT=3306

REDIS_PORT=6379

FRONTEND_PORT=3001

JAVA_BACKEND_PORT=8081

PHPMYADMIN_PORT=8089

SPARK_MASTER_PORT=7077

SPARK_WEBUI_PORT=8080



# ====== 大数据服务端口 (with-bigdata) ======

ZK_PORT=2181

HDFS_NAMENODE_PORT=9000

HDFS_NAMENODE_HTTP_PORT=50070

HDFS_DATANODE_HTTP_PORT=50075

HBASE_MASTER_PORT=16000

HBASE_MASTER_WEBUI_PORT=16010

HBASE_RS_PORT=16020

HBASE_RS_WEBUI_PORT=16030

HBASE_THRIFT_PORT=9090



# ====== 启用的 Profiles (逗号分隔) ======

# 可选: with-frontend, with-java-backend, with-spark, with-bigdata

# 默认启用全部; 轻量部署可移除 with-bigdata

ENABLED_PROFILES=with-frontend,with-java-backend,with-spark,with-bigdata



# ====== Flask 配置 ======

FLASK_ENV=production

LOG_LEVEL=INFO



# ====== 安全密钥 (必须修改!) ======

SECRET_KEY=your-secret-key-at-least-32-characters-change-this

JWT_SECRET=your-jwt-secret-key-change-this-in-production



# ====== 数据库配置 (必须修改!) ======

DB_NAME=weibo_sentiment

DB_USER=weibo_user

DB_PASSWORD=YourStrongPassword123!

DB_ROOT_PASSWORD=YourRootPassword456!



# ====== Redis 配置 ======

REDIS_PASSWORD=



# ====== Spark 资源配置 (适配 10GB 内存虚拟机) ======

SPARK_WORKER_MEMORY=4g

SPARK_WORKER_CORES=2

SPARK_WORKER_MEMORY_LIMIT=4608M



# ====== 安全提醒 ======

# 1. 生产环境必须修改所有默认密码

# 2. SECRET_KEY / JWT_SECRET 必须使用强随机字符串

#    生成方法: python3 -c "import secrets; print(secrets.token_hex(32))"

# 3. 切勿将修改后的 .env.docker 提交到版本控制

