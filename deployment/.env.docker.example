# ====================================================================
# 微博情感分析系统 - Docker 环境变量模板 (精简版 7 容器)
# ====================================================================
# 容器: db / web / frontend / namenode / datanode / spark-master / spark-worker
# VM 推荐: 8GB+ 内存, 4+ 核, 30GB+ 磁盘
# 使用:
#   cp .env.docker.example .env.docker && vim .env.docker
#   docker compose --env-file .env.docker up -d
# ====================================================================

# ====== 服务端口 ======
WEB_PORT=5000
DB_PORT=3306
FRONTEND_PORT=3001
SPARK_MASTER_PORT=7077
SPARK_WEBUI_PORT=8080
HDFS_NAMENODE_PORT=9000
HDFS_NAMENODE_HTTP_PORT=9870
HDFS_DATANODE_HTTP_PORT=9864

# ====== Flask 配置 ======
FLASK_ENV=production
LOG_LEVEL=INFO
# 关闭 Spark 模拟模式，真正提交到 Standalone Master
SPARK_ALLOW_SIM=0

# ====== 安全密钥 (生产环境必须修改!) ======
SECRET_KEY=dev-secret-key-change-in-production-use-secrets-token-hex
JWT_SECRET=dev-jwt-secret-change-in-production-use-secrets-token-hex

# ====== 数据库配置 (生产环境必须修改!) ======
DB_NAME=weibo_sentiment
DB_USER=weibo_user
DB_PASSWORD=123456
DB_ROOT_PASSWORD=123456

# ====== 邮箱验证码 SMTP (可选) ======
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=微博舆情分析系统

# ====== Spark Worker 资源 ======
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY_LIMIT=3072M

# ====== 安全提醒 ======
# 1. 开发测试环境可直接使用默认密码 123456
# 2. 生产环境必须修改所有密码和密钥
#    生成方法: python3 -c "import secrets; print(secrets.token_hex(32))"
# 3. 切勿将修改后的 .env.docker 提交到版本控制
