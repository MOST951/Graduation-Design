# ===================================================================
# Dockerfile for Spring Boot Backend (Multi-stage)
# ===================================================================

# --- Stage 1: Build --- 
# Use a full JDK with Maven to build the application.
FROM maven:3.8.4-openjdk-8 AS builder

WORKDIR /build

# Copy POMs and download dependencies first to leverage Docker's layer caching.
COPY ../../pom.xml .
COPY ../../web-backend/pom.xml ./web-backend/
# Add other modules if they exist (e.g., common, sentiment-analysis)
# COPY ../../common/pom.xml ./common/

# Download dependencies
RUN mvn dependency:go-offline

# Copy the source code
COPY ../../web-backend/src ./web-backend/src
# COPY ../../common/src ./common/src

# Build the application, skipping tests as they should be run in a CI pipeline.
RUN mvn -f ./web-backend/pom.xml clean package -DskipTests

# ===================================================================
# --- Stage 2: Run --- 
# Use a minimal JRE image for a smaller and more secure footprint.
FROM openjdk:8-jre-alpine

WORKDIR /app

# Environment variables for timezone and JVM options
ENV TZ=Asia/Shanghai \
    JAVA_OPTS="-Xms256m -Xmx512m -XX:+HeapDumpOnOutOfMemoryError"

# Install required packages (timezone data) and create a non-root user.
RUN apk --no-cache add tzdata \
    && addgroup -S appgroup && adduser -S appuser -G appgroup

# Copy the executable JAR from the builder stage.
COPY --from=builder /build/web-backend/target/*.jar app.jar

# Copy a startup script (optional but good practice).
# COPY deployment/docker/scripts/start-backend.sh start.sh
# RUN chmod +x start.sh

# Change ownership of the app directory to the non-root user.
RUN chown -R appuser:appgroup /app

# Switch to the non-root user.
USER appuser

# Health check to verify the application is running and healthy.
# Assumes Spring Boot Actuator is enabled.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -q --spider http://localhost:8080/api/actuator/health || exit 1

# Expose the application port.
EXPOSE 8080

# The command to run the application.
# The JAVA_OPTS environment variable will be picked up automatically.
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
# Or, if using a startup script:
# ENTRYPOINT ["./start.sh"]
