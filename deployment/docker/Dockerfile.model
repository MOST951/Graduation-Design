# ===================================================================
# Dockerfile for Python Model Service (FastAPI)
# ===================================================================

# Use a slim Python base image for a smaller footprint.
FROM python:3.8-slim

WORKDIR /app

# Set environment variables to prevent Python from writing .pyc files.
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

# Install system dependencies that might be required by Python packages.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy the requirements file and install dependencies first to leverage caching.
# Assumes the model service code is in `model-serving` directory.
COPY ../../model-serving/requirements.txt .

# Install PyTorch and Transformers first, specifying the CPU version for inference.
# This can be changed to a CUDA version if running on a GPU.
RUN pip install --no-cache-dir torch==1.10.0+cpu torchvision==0.11.1+cpu -f https://download.pytorch.org/whl/cpu/torch_stable.html
RUN pip install --no-cache-dir transformers==4.12.5

# Install the rest of the dependencies.
RUN pip install --no-cache-dir -r requirements.txt

# Copy the application code and the pre-trained model files.
COPY ../../model-serving/app/ ./app/
COPY ../../model-training/models/bert_sentiment_model/ ./models/bert_sentiment_model/

# Health check to verify the API is responsive.
# Assumes a `/health` endpoint exists in the FastAPI application.
HEALTHCHECK --interval=20s --timeout=3s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

# Expose the port the FastAPI application will run on.
EXPOSE 8000

# The command to run the application using Uvicorn.
# It will run the `app` instance from the `main.py` file in the `app` directory.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
