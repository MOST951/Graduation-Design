# ====================================================================
# 微博情感分析系统 - Java 后端 (Spring Boot) Dockerfile
# ====================================================================
# 多阶段构建: Maven 编译 → JRE 运行
# 构建上下文: 项目根目录 (context: ..)
# 无需在宿主机安装 Maven，Docker 内完成全部编译
# ====================================================================

# ==================== 阶段 1: Maven 编译 ====================
FROM maven:3.8-openjdk-11-slim AS builder

# 使用阿里云 Maven 镜像 (国内加速)
COPY deployment/docker/maven-settings.xml /usr/share/maven/conf/settings.xml

WORKDIR /build

# 先复制所有 pom.xml (利用 Docker 缓存, 依赖不变时不重新下载)
COPY pom.xml ./
COPY common/pom.xml ./common/
COPY web-backend/pom.xml ./web-backend/
COPY data-collector/pom.xml ./data-collector/
COPY sentiment-analysis/pom.xml ./sentiment-analysis/
COPY model-training/pom.xml ./model-training/

# 移除不参与编译的模块声明 (deployment 无 pom.xml)
RUN sed -i '/<module>deployment<\/module>/d' pom.xml

# 仅下载依赖 (缓存层, 源码变更不会重新下载)
RUN mvn dependency:go-offline -pl web-backend -am \
    -Dmaven.test.skip=true -q || true

# 复制源码
COPY common/src ./common/src
COPY web-backend/src ./web-backend/src

# 编译打包 (只构建 common + web-backend)
RUN mvn clean package -pl web-backend -am \
    -Dmaven.test.skip=true -Dmaven.javadoc.skip=true -q

# ==================== 阶段 2: JRE 运行 ====================
FROM eclipse-temurin:11-jre-jammy

ENV TZ=Asia/Shanghai \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 从构建阶段复制 JAR
COPY --from=builder /build/web-backend/target/web-backend-*.jar app.jar

EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD curl -sf http://localhost:8081/api/actuator/health || exit 1

ENTRYPOINT ["java", \
    "-Xmx256m", "-Xms128m", \
    "-Dfile.encoding=UTF-8", \
    "-Duser.timezone=Asia/Shanghai", \
    "-jar", "app.jar"]
