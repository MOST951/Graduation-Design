# ====================================================================
# 微博情感分析系统 - 环境变量模板
# ====================================================================
# 使用说明:
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 修改 .env 中的配置值
# 3. 切勿将 .env 提交到版本控制
# ====================================================================

# ====== 数据库配置 (MySQL) ======
DB_HOST=localhost
DB_PORT=3306
DB_NAME=weibo_prod
DB_USER=prod_user
DB_PASSWORD=your_secure_password
DB_CHARSET=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ====== Redis 配置 ======
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=5
REDIS_POOL_MAX_CONNECTIONS=50

# ====== HBase 配置 ======
HBASE_QUORUM=localhost
HBASE_PORT=9090
HBASE_TIMEOUT=30000

# ====== Spark 配置 ======
SPARK_MASTER_URL=local[*]
SPARK_APP_NAME=WeiboSentimentAnalysis
SPARK_EXECUTOR_MEMORY=2g
SPARK_DRIVER_MEMORY=1g
SPARK_MAX_RESULT_SIZE=1g
SPARK_EXECUTOR_CORES=2
SPARK_DRIVER_CORES=1
SPARK_DEFAULT_PARALLELISM=100
SPARK_SQL_ADAPTIVE_ENABLED=true
SPARK_SQL_ADAPTIVE_COALESCE_ENABLED=true

# ====== Flask 应用配置 ======
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
FLASK_TESTING=false
SECRET_KEY=your-secret-key-at-least-32-characters-long
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ====== 日志配置 ======
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE_PATH=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ====== 安全配置 ======
JWT_SECRET_KEY=your-jwt-secret-key-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=86400
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
SESSION_TIMEOUT=1800

# ====== 爬虫配置 ======
CRAWLER_DEFAULT_INTERVAL=1.0
CRAWLER_MAX_CONCURRENT=5
CRAWLER_REQUEST_TIMEOUT=30
CRAWLER_MAX_RETRIES=3
CRAWLER_RETRY_DELAY=1.0
CRAWLER_USER_AGENT_ROTATION=true
CRAWLER_USE_PROXY=false
PROXY_LIST=

# ====== 模型配置 ======
MODEL_CACHE_DIR=./model_cache
DEFAULT_SENTIMENT_MODEL=bert-base-chinese
CONFIDENCE_THRESHOLD=0.7
MODEL_BATCH_SIZE=32
MODEL_MAX_SEQUENCE_LENGTH=512
MODEL_USE_GPU=false

# ====== 微博 API 配置 (可选) ======
# WEIBO_APP_KEY=your_app_key
# WEIBO_APP_SECRET=your_app_secret
# WEIBO_REDIRECT_URI=http://localhost:5000/callback

# ====== 安全提醒 ======
# 1. 生产环境必须修改所有默认密码
# 2. SECRET_KEY 必须使用强随机字符串
# 3. FLASK_DEBUG 生产环境必须为 False
# 4. 定期轮换敏感凭据
# 5. 使用安全的代理服务器
# 6. 定期更新依赖库
# 7. 使用安全的密码哈希算法
