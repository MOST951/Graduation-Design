{
  "_description": "情感分析权重配置文件",
  "_version": "1.0.0",
  "_updated": "2024-01-01",
  
  "sentiment_weights": {
    "_comment": "情感词权重配置",
    "positive_base": 1.0,
    "negative_base": -1.0,
    "neutral_base": 0.0
  },
  
  "degree_modifiers": {
    "_comment": "程度副词修饰系数",
    "extreme_high": 2.5,
    "very_high": 2.0,
    "high": 1.5,
    "medium": 1.2,
    "low": 0.8,
    "very_low": 0.5
  },
  
  "negation_rules": {
    "_comment": "否定词处理规则",
    "full_negation": -1.0,
    "partial_negation": -0.5,
    "double_negation": 0.8,
    "negation_window": 3
  },
  
  "context_rules": {
    "_comment": "上下文规则",
    "conjunction_weight": 0.8,
    "transition_weight": 1.2,
    "emphasis_weight": 1.5
  },
  
  "domain_weights": {
    "_comment": "领域词典权重",
    "basic": 1.0,
    "weibo": 1.2,
    "pandemic": 1.1,
    "entertainment": 1.1,
    "tourism": 1.0,
    "politics": 1.0,
    "technology": 1.0,
    "finance": 1.0
  },
  
  "emoji_weights": {
    "_comment": "表情符号权重",
    "unicode_emoji": 1.0,
    "weibo_emoji": 1.1,
    "kaomoji": 0.9
  },
  
  "source_weights": {
    "_comment": "数据来源权重",
    "verified_user": 1.2,
    "normal_user": 1.0,
    "anonymous": 0.8
  },
  
  "time_decay": {
    "_comment": "时间衰减配置",
    "enabled": true,
    "half_life_hours": 24,
    "min_weight": 0.5
  },
  
  "aggregation": {
    "_comment": "聚合计算配置",
    "method": "weighted_average",
    "min_confidence": 0.3,
    "smoothing_factor": 0.1
  },
  
  "thresholds": {
    "_comment": "情感分类阈值",
    "positive": 0.2,
    "negative": -0.2,
    "strong_positive": 0.6,
    "strong_negative": -0.6,
    "very_strong_positive": 0.8,
    "very_strong_negative": -0.8
  },
  
  "labels": {
    "_comment": "情感标签映射",
    "very_strong_positive": "极度正面",
    "strong_positive": "强烈正面",
    "positive": "正面",
    "neutral": "中性",
    "negative": "负面",
    "strong_negative": "强烈负面",
    "very_strong_negative": "极度负面"
  },
  
  "special_patterns": {
    "_comment": "特殊模式配置",
    "irony_detection": true,
    "sarcasm_keywords": ["呵呵", "哦", "好吧", "随便", "算了"],
    "question_weight": 0.5,
    "exclamation_weight": 1.3
  },
  
  "preprocessing": {
    "_comment": "预处理配置",
    "remove_urls": true,
    "remove_mentions": false,
    "remove_hashtags": false,
    "lowercase": true,
    "remove_punctuation": false,
    "min_text_length": 2
  },
  
  "dictionary_paths": {
    "_comment": "词典文件路径",
    "basic": {
      "positive": "basic/positive.txt",
      "negative": "basic/negative.txt",
      "degree": "basic/degree.txt",
      "negation": "basic/negation.txt"
    },
    "weibo": {
      "emoji": "weibo/emoji.txt",
      "internet": "weibo/internet.txt",
      "abbreviation": "weibo/abbreviation.txt"
    },
    "domain": {
      "pandemic": "domain/pandemic.txt",
      "entertainment": "domain/entertainment.txt",
      "tourism": "domain/tourism.txt"
    }
  },
  
  "model_config": {
    "_comment": "模型配置",
    "use_ml_model": false,
    "ml_model_path": "models/sentiment_model.pkl",
    "use_bert": false,
    "bert_model_name": "bert-base-chinese",
    "ensemble_weights": {
      "lexicon": 0.4,
      "ml": 0.3,
      "bert": 0.3
    }
  },
  
  "cache_config": {
    "_comment": "缓存配置",
    "enabled": true,
    "max_size": 10000,
    "ttl_seconds": 3600
  },
  
  "logging": {
    "_comment": "日志配置",
    "level": "INFO",
    "log_predictions": false,
    "log_errors": true
  }
}
