# ====================================================================
# Docker Build Context 排除规则
# ====================================================================

# 版本控制
.git
.github
.gitignore

# IDE
.idea
.vscode
.cursor
*.iml

# 构建输出 (Maven 多阶段构建在 Docker 内进行, 排除本地产物)
**/target/
node_modules/
dist/
web-frontend/node_modules/
web-frontend/dist/

# 日志 & 临时文件
logs/
*.log
*.tmp
*.bak

# 环境变量 (敏感信息)
.env
.env.docker

# 文档 (不需要进入镜像)
docs/
*.md
!backend-python/README.md

# 测试
tests/
__pycache__/
.pytest_cache/

# 数据 & 模型缓存 (~4GB, 严禁打进镜像; 容器运行时会从 HF/本地挂载加载)
model_cache/
models/
model_cache_ms/
backend-python/model_cache/
backend-python/models/
backend-python/model_cache_ms/
backend-python/data/
*.db
*.sqlite3
*.pt
*.bin
*.safetensors
*.onnx

# npm/pnpm cache
.npm-cache/
**/.npm-cache/
**/__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db
Desktop.ini
