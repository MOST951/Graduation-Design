# ====================================================================
# Docker Build Context 排除规则
# ====================================================================

# 版本控制
.git
.github
.gitignore

# IDE
.idea
.vscode
.cursor
*.iml

# 构建输出 (Maven 多阶段构建在 Docker 内进行, 排除本地产物)
**/target/
node_modules/
dist/
web-frontend/node_modules/
web-frontend/dist/

# 日志 & 临时文件
logs/
*.log
*.tmp
*.bak

# 环境变量 (敏感信息)
.env
.env.docker

# 文档 (不需要进入镜像)
docs/
*.md
!backend-python/README.md

# 测试
tests/
__pycache__/
.pytest_cache/

# 数据 & 模型缓存
model_cache/
backend-python/model_cache/
backend-python/data/weibo_raw/
backend-python/data/storage/
*.db
*.sqlite3

# OS
.DS_Store
Thumbs.db
Desktop.ini
